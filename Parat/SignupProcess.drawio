        <mxCell id="MESAC6d0Qj6qYFJvGU92-173" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#102337;spacing=0;fontStyle=1;fontSize=21;fontColor=#425B71;" value="Dine meldemsfordeler" vertex="1">
